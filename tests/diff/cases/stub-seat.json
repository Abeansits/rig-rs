{
  "id": "stub-seat",
  "project": "full",
  "expected_diff": "PE-007",
  "normalize": ["ulid", "timestamp", "socketpath", "abspath", "port", "getcwd"],
  "steps": [
    {
      "op": "write_file",
      "path": "two-stub.yaml",
      "body": "name: pair\nseats:\n  - name: one\n    runtime: stub\n  - name: two\n    runtime: stub\n"
    },
    { "op": "cli", "argv": ["up", "two-stub.yaml", "--json"] },
    { "op": "cli", "argv": ["ps", "--json"] },
    { "op": "cli", "argv": ["capture", "one", "--json"] },
    { "op": "cli", "argv": ["down", "--json"] }
  ]
}
